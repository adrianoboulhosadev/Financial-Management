# Backend (Nest) URL the app talks to. Read at build time by Expo, so changing
# it means rebuilding the app — same rule as the web's NEXT_PUBLIC_API_URL.
# On a physical device this can never be "localhost": that resolves to the
# PHONE, not to your machine. Use the machine's IP on the same network
# (e.g. http://192.168.0.10:5000) or the deployed URL.
EXPO_PUBLIC_API_URL="http://localhost:5000"
